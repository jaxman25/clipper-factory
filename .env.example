# ===== Required =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PIXABAY_API_KEY=
TZ=Africa/Nairobi

# ===== Instagram (Meta Graph API) =====
# Instagram Business/Creator account linked to a Facebook Page.
# Get these from https://developers.facebook.com/tools/explorer/
IG_USER_ID=
IG_ACCESS_TOKEN=
# Age of the Graph API release used by /auto-post/instagram.js
IG_GRAPH_VERSION=v21.0

# ===== TikTok (Playwright browser session) =====
# Local login: python auto-post/tiktok_auto.py --login
# On Render: paste base64 of the generated auth.json (see README-RENDER.md)
TIKTOK_AUTH_B64=
TIKTOK_HEADLESS=1

# ===== Runtime =====
# Where downloads/exports/queue/posted live. /tmp is the Render-safe default.
ACF_DATA_ROOT=/tmp
# Model used by faster-whisper: tiny (512MB-safe), base, small...
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8
# Run the 19:00/21:00 EAT scheduler inside the bot process (needed on the free
# Render plan, where Cron Jobs are not free). 0 = rely on Render Cron Jobs.
ACF_ENABLE_SCHEDULER=1
PYTHON_BIN=python3
# Public origin used by Instagram to fetch the video. Render sets RENDER_EXTERNAL_URL
# automatically; set this only if you use a custom domain.
PUBLIC_BASE_URL=

# ===== Optional dashboard protection (HTTP Basic) =====
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# ===== Optional YouTube cookies (needed when YouTube blocks datacenter IPs) =====
# Path to a Netscape-format cookies.txt file.
YTDLP_COOKIES=

# Admin email for setting up the credit system in order to never get locked out.
# The signed-in account matching this email bypasses credits entirely.
ADMIN_EMAIL=your_email_address@gmail.com

# ===== Auth (next-auth) =====
# Signs session/JWT cookies. Generate once: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public origin of this app (http://localhost:3000 locally, your Render URL
# in production). Used for OAuth redirects.
NEXTAUTH_URL=

# Optional Google sign-in - leave empty to show only email/password login.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# User/credit store location. Default: <project>/data/users.json (gitignored).
# On Render, mount a persistent disk and point this at it to keep balances
# across deploys, e.g. /data/users.json
ACF_USERS_FILE=

# ===== Transform pipeline (AI rewrite + edge-tts voiceover) =====
# Free LLM provider for script rewriting: gemini | openrouter
# (empty = built-in template fallback, no key required - never a paid OpenAI key)
LLM_PROVIDER=
# Gemini: https://aistudio.google.com/apikey  OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=
# Optional model override (default: gemini-2.0-flash / meta-llama/llama-3-8b-instruct:free)
LLM_MODEL=
# edge-tts neural voice: en-US-AriaNeural (default) or en-US-GuyNeural
EDGE_VOICE=en-US-AriaNeural
# Handle stamped as a text watermark on transform outputs (overrides config.json "handle")
WATERMARK_HANDLE=@yourhandle
